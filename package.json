{
  "name": "kirmy-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kirmy's Discord AI core powered by the official xAI API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/bot.js",
    "test": "node --test",
    "check": "for file in src/*.js scripts/*.js; do node --check \"$file\" || exit; done",
    "memory:backup": "node scripts/backup-memory.js backup",
    "memory:verify": "node scripts/backup-memory.js verify"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.22.0"
  }
}
