{
  "name": "owaua-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owaua's Discord AI core powered by xAI and Mistral APIs",
  "engines": {
    "node": "^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "start": "node src/bot.js",
    "host": "node scripts/owaua-host.js",
    "bot:start": "node src/host-control.js start",
    "bot:stop": "node src/host-control.js stop",
    "bot:status": "node src/host-control.js status",
    "test": "node src/runtime.js && node --test",
    "check": "node src/runtime.js && for file in src/*.js scripts/*.js; do node --check \"$file\" || exit; done && for file in scripts/*.sh scripts/owaua scripts/start scripts/stop; do bash -n \"$file\" || exit; done",
    "memory:backup": "node scripts/backup-memory.js backup",
    "memory:verify": "node scripts/backup-memory.js verify"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "ws": "^8.22.0"
  }
}
