DISCORD_TOKEN=
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional: native Collections indexing; persistent Files libraries work without it.
XAI_MANAGEMENT_API_KEY=
# Optional: deployment-owned read-only MCP entries; xai_docs/deepwiki are built in.
MCP_SERVERS_JSON=
DATA_DIR=./data
MAX_OUTPUT_TOKENS=4096
# Local dispatch cap and remaining provider assistant/tool-turn ceiling.
# Hosted tools may make multiple calls per turn; this is not a spending cap.
MAX_TOOL_CALLS=8
MAX_TOOL_ROUNDS=4
MAX_CONTEXT_TURNS=16
# Archive size is independent of the recent exchanges sent to the model.
MAX_ARCHIVE_TURNS=1000
HISTORY_RETENTION_DAYS=180
MAX_CONTEXT_CHARACTERS=32000
REQUEST_TIMEOUT_MS=180000
MEDIA_TIMEOUT_MS=600000
USER_COOLDOWN_SECONDS=5
MAX_CONCURRENT_REQUESTS=3
# Optional: comma-separated Discord guild IDs. Empty allows all joined guilds.
ALLOWED_GUILD_IDS=
