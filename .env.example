DISCORD_TOKEN=
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Low reasoning favors reply speed. /ask reasoning:... overrides it per request.
# Applies to grok-4.5/4.6/4.7; other models keep their provider defaults.
XAI_REASONING_EFFORT=low
# Optional: enables /jiki with the HTTPS root of the private Qwen gateway and its bearer key.
QWEN_API_URL=
QWEN_API_KEY=
# Optional: native Collections indexing; persistent Files libraries work without it.
XAI_MANAGEMENT_API_KEY=
# Optional: deployment-owned read-only MCP entries; xai_docs/deepwiki are built in.
MCP_SERVERS_JSON=
DATA_DIR=./data
MAX_OUTPUT_TOKENS=4096
# Local dispatch cap and remaining provider assistant/tool-turn ceiling.
# Hosted tools may make multiple calls per turn; this is not a spending cap.
MAX_TOOL_CALLS=8
MAX_TOOL_ROUNDS=4
MAX_CONTEXT_TURNS=16
# Archive size is independent of the recent exchanges sent to the model.
MAX_ARCHIVE_TURNS=1000
HISTORY_RETENTION_DAYS=180
MAX_CONTEXT_CHARACTERS=32000
REQUEST_TIMEOUT_MS=180000
MEDIA_TIMEOUT_MS=600000
USER_COOLDOWN_SECONDS=5
MAX_CONCURRENT_REQUESTS=3
# Persistent request limits (all users including owner); daily reset: Europe/Budapest.
USER_DAILY_REQUEST_LIMIT=60
SERVER_DAILY_REQUEST_LIMIT=300
BOT_DAILY_REQUEST_LIMIT=1000
# Rolling 60-second admission limits.
USER_MINUTE_REQUEST_LIMIT=5
SERVER_MINUTE_REQUEST_LIMIT=30
BOT_MINUTE_REQUEST_LIMIT=60
# Daily realtime voice session starts, also counted in general request limits.
USER_VOICE_REQUEST_LIMIT=3
SERVER_VOICE_REQUEST_LIMIT=10
BOT_VOICE_REQUEST_LIMIT=20
# Optional: comma-separated Discord guild IDs. Empty allows all joined guilds.
ALLOWED_GUILD_IDS=
